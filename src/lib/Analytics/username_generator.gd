var _rng = RandomNumberGenerator.new()

func _init() -> void:
	_rng.randomize()

func generate_username() -> String:
	if USERNAMES.empty():
		return "Player%03d" % _rng.randi_range(0, 999)

	var base_name = USERNAMES[_rng.randi_range(0, USERNAMES.size() - 1)]
	var digits = "%03d" % _rng.randi_range(0, 999)
	return "%s%s" % [base_name, digits]
